#!/usr/bin/env python3
"""Symbolicate the MetricKit reports in a debug trace against the dSYMs build-and-sign kept.

    debugtrace-symbolicate <trace id | trace folder | crashes/<id>.json | crash.ips> [--all] [--dsyms DIR]

A trace id is looked up in the appstore's data/traces (APPSTORE_DATA overrides). dSYMs
come from ~/.local/state/debugtrace/dsyms (DEBUGTRACE_DSYM_DIR, or --dsyms): build-and-sign
keeps one set per app and device (the build installed last and the one before it). Frames of
binaries it has no dSYM for (Apple's, or an older build) are printed as `name +offset`, or with
the symbol the device already put in an .ips.

By default only the thread the OS blamed is printed; --all prints every thread, following
the heaviest path through a hang's sample tree. See Docs/traces.md."""
import argparse
import glob
import json
import os
import re
import shlex
import subprocess
import sys

STATE = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
DEFAULT_DSYMS = os.environ.get("DEBUGTRACE_DSYM_DIR") or os.path.join(STATE, "debugtrace", "dsyms")
DEFAULT_TRACES = os.path.join(os.environ.get("APPSTORE_DATA") or os.path.expanduser("~/Projects/appstore/data"), "traces")


def report_files(target):
    if os.path.isfile(target):
        return [target]
    for base in (target, os.path.join(target, "files"), os.path.join(DEFAULT_TRACES, target, "files")):
        found = sorted(glob.glob(os.path.join(base, "crashes", "*.json")))
        if found:
            return found
    return []


def find_trees(node, label="report", meta=None):
    """Every callStackTree in a report, with its label and the diagnostic around it. The
    27+ layout nests one `crashDiagnostic`; the older payload lists `crashDiagnostics`."""
    if isinstance(node, dict):
        if "callStackTree" in node:
            yield label, node["callStackTree"], node
        for key, value in node.items():
            if key != "callStackTree":
                yield from find_trees(value, key, meta)
    elif isinstance(node, list):
        for item in node:
            yield from find_trees(item, label, meta)


def heaviest(frame):
    """A frame's chain down the busiest branch: a crash is one chain, a hang a tree."""
    chain = []
    while frame:
        chain.append(frame)
        subs = frame.get("subFrames") or []
        frame = max(subs, key=lambda f: f.get("sampleCount", 0)) if subs else None
    return chain


def flat_chains(frames):
    """Each root's heaviest chain from a flat frame list: DebugTrace stores a tree depth
    first as `frames`, each frame with its `depth` (0 for a root) and no `subFrames`,
    because MetricKit's nesting (one level per frame) overflowed the device's stack."""
    chains, i = [], 0
    while i < len(frames):
        if frames[i].get("depth", 0) != 0:
            i += 1
            continue
        chain, j = [frames[i]], i
        while True:
            depth = frames[j].get("depth", 0)
            best, k = None, j + 1
            while k < len(frames) and frames[k].get("depth", 0) > depth:
                if frames[k].get("depth", 0) == depth + 1 and (
                        best is None or frames[k].get("sampleCount", 0) > frames[best].get("sampleCount", 0)):
                    best = k
                k += 1
            if best is None:
                break
            chain.append(frames[best])
            j = best
        chains.append(chain)
        i += 1
    return chains


def threads(tree):
    """[(attributed, [frame, ...])] for either layout, each frame {uuid, name, offset}."""
    names = {b["uuid"]: b.get("name", "?") for b in tree.get("binaryInfo", [])}
    raw = []  # (attributed, chain of frames)
    for t in tree.get("callStackThreads", []) + tree.get("callStacks", []):  # 27+, then before 27
        attributed = t.get("threadAttributed", False)
        if isinstance(t.get("frames"), list):  # flattened by DebugTrace
            raw += [(attributed, chain) for chain in flat_chains(t["frames"])]
        roots = t.get("rootFrames", [])
        legacy = t.get("callStackRootFrames")
        roots = roots + ([legacy] if isinstance(legacy, dict) else legacy if isinstance(legacy, list) else [])
        raw += [(attributed, heaviest(root)) for root in roots if isinstance(root, dict)]
    out = []
    for attributed, chain in raw:
        frames = [{"uuid": f.get("binaryUUID"), "offset": f.get("offsetIntoBinaryTextSegment", 0),
                   "name": f.get("binaryName") or names.get(f.get("binaryUUID"), "?")} for f in chain]
        out.append((attributed, frames))
    return out


def archive(dsyms_dir):
    """UUID -> {dwarf, arch, bundleId, device, build}; the newest archive wins a duplicate."""
    found = {}
    for path in sorted(glob.glob(os.path.join(dsyms_dir, "*", "uuids.json")), key=os.path.getmtime):
        try:
            slot = json.load(open(path))
        except (OSError, ValueError):
            continue
        for uuid, info in slot.get("uuids", {}).items():
            found[uuid] = {**info, "dwarf": os.path.join(os.path.dirname(path), info["dwarf"]),
                           "bundleId": slot.get("bundleId"), "device": slot.get("device"), "build": slot.get("build")}
    return found


def text_vmaddr(dwarf):
    out = subprocess.run(["otool", "-l", dwarf], capture_output=True, text=True).stdout
    m = re.search(r"segname __TEXT\s+vmaddr (0x[0-9a-f]+)", out)
    return int(m.group(1), 16) if m else 0x100000000


def atos(dwarf, arch, vmaddr, offsets):
    cmd = shlex.split(os.environ.get("DEBUGTRACE_ATOS", "xcrun atos")) + [
        "-arch", arch, "-o", dwarf, "-l", hex(vmaddr)] + [hex(vmaddr + o) for o in offsets]
    out = subprocess.run(cmd, capture_output=True, text=True).stdout.splitlines()
    return out if len(out) == len(offsets) else [None] * len(offsets)


def symbolicate(frames, known):
    """Adds `symbol` to every frame whose binary has a kept dSYM, one atos call per binary."""
    by_uuid = {}
    for frame in frames:
        if frame["uuid"] in known:
            by_uuid.setdefault(frame["uuid"], []).append(frame)
    for uuid, group in by_uuid.items():
        info = known[uuid]
        offsets = sorted({f["offset"] for f in group})
        resolved = dict(zip(offsets, atos(info["dwarf"], info["arch"], text_vmaddr(info["dwarf"]), offsets)))
        for frame in group:
            symbol = resolved.get(frame["offset"])
            # atos echoes the bare address when it cannot resolve.
            if symbol and not re.fullmatch(r"0x[0-9a-f]+", symbol.strip()):
                frame["symbol"] = symbol.strip()


def split_ips(text):
    """(header, body) of an .ips: a JSON header line, then the JSON report."""
    head, _, rest = text.partition("\n")
    return json.loads(head), json.loads(rest)


def ips_threads(body):
    """[(blamed, [frame, ...])]. A frame is {uuid, name, offset, embedded}, `embedded` being the
    symbol the device already resolved (Apple's frames, mostly)."""
    images = body.get("usedImages", [])
    out = []
    for index, thread in enumerate(body.get("threads", [])):
        frames = []
        for f in thread.get("frames", []):
            image = images[f["imageIndex"]] if 0 <= f.get("imageIndex", -1) < len(images) else {}
            embedded = f.get("symbol")
            if embedded and f.get("sourceFile"):
                embedded += f" ({f['sourceFile']}:{f.get('sourceLine', '?')})"
            elif embedded and "symbolLocation" in f:
                embedded += f" + {f['symbolLocation']}"
            frames.append({"uuid": (image.get("uuid") or "").upper(), "name": image.get("name", "?"),
                           "offset": f.get("imageOffset", 0), "embedded": embedded})
        blamed = thread.get("triggered", False) or index == body.get("faultingThread", -1)
        out.append((blamed, frames))
    return out


def render_ips(path, show_all, known, out=sys.stdout):
    header, body = split_ips(open(path).read())
    exception = body.get("exception") or {}
    termination = body.get("termination") or {}
    facts = ", ".join(x for x in (exception.get("type"), exception.get("signal"), termination.get("indicator")) if x)
    print(f"== {os.path.basename(path)}  {header.get('app_name', '?')} {header.get('app_version', '')}"
          f" ({header.get('build_version', '?')})  {header.get('os_version', '')}", file=out)
    print(f"-- {facts or 'no exception info'}  pid {body.get('pid', '?')}  captured {body.get('captureTime', '?')}", file=out)
    asi = body.get("asi")
    if asi:
        print(f"   asi: {json.dumps(asi)[:400]}", file=out)
    all_threads = ips_threads(body)
    for _, frames in all_threads:
        symbolicate(frames, known)
    shown = [(b, f) for b, f in all_threads if b or show_all] or all_threads[:1]
    for number, (blamed, frames) in enumerate(shown):
        print(f"   thread {number}{' (blamed)' if blamed else ''}", file=out)
        for n, frame in enumerate(frames):
            where = frame.get("symbol") or frame.get("embedded") or f"{frame['name']} +{hex(frame['offset'])}"
            print(f"     #{n:<2} {frame['name']:<28} {where}", file=out)
    own = {f["uuid"] for _, fs in all_threads for f in fs if f["uuid"] in known}
    if not own:
        print("   no dSYM kept for this build's binary: app frames are unresolved", file=out)


def describe(diagnostic):
    meta = diagnostic.get("diagnosticMetaData") or {}
    env = diagnostic.get("environment") or {}
    bits = [f"{k} {v}" for k, v in (("signal", diagnostic.get("signal", meta.get("signal"))),
                                    ("exception type", diagnostic.get("exceptionType", meta.get("exceptionType"))),
                                    ("reason", diagnostic.get("terminationReason", meta.get("terminationReason")))) if v is not None]
    build = meta.get("appBuildVersion") or env.get("applicationBuildVersion")
    return build, ", ".join(bits)


def render(path, show_all, known, out=sys.stdout):
    envelope = json.load(open(path))
    report = envelope.get("report", envelope)
    top_build = (report.get("environment") or {}).get("applicationBuildVersion")
    print(f"== {os.path.basename(path)}  {', '.join(envelope.get('kinds', []))}  received {envelope.get('receivedAt', '?')}"
          f"  via {envelope.get('source', '?')}", file=out)
    trees = list(find_trees(report))
    if not trees:
        print("   no call-stack tree in this report", file=out)
    for label, tree, diagnostic in trees:
        build, facts = describe(diagnostic if "diagnosticMetaData" in diagnostic else {**report, **diagnostic})
        print(f"-- {label}: crashed build {build or top_build or '?'}{'  ' + facts if facts else ''}", file=out)
        all_threads = threads(tree)
        for _, frames in all_threads:
            symbolicate(frames, known)
        shown = [(a, f) for a, f in all_threads if a or show_all] or all_threads[:1]
        for index, (attributed, frames) in enumerate(shown):
            print(f"   thread {index}{' (blamed)' if attributed else ''}", file=out)
            for n, frame in enumerate(frames):
                where = frame.get("symbol") or f"{frame['name']} +{hex(frame['offset'])}"
                print(f"     #{n:<2} {frame['name']:<28} {where}", file=out)
        blamed = next((f for a, f in all_threads if a), [])
        missing = sorted({f["name"] for f in blamed if "symbol" not in f})
        if missing:
            print(f"   unsymbolicated in the blamed thread: {', '.join(missing)} (no dSYM kept for that build, or not the app's)", file=out)
        if not known:
            print("   no dSYMs kept: deploy with build-and-sign to a device first", file=out)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("target", help="trace id, trace folder, or a crashes/<id>.json file")
    parser.add_argument("--all", action="store_true", help="print every thread, not only the blamed one")
    parser.add_argument("--dsyms", default=DEFAULT_DSYMS, help=f"dSYM archive (default {DEFAULT_DSYMS})")
    args = parser.parse_args()
    if args.target.endswith(".ips") and os.path.isfile(args.target):
        render_ips(args.target, args.all, archive(args.dsyms))
        return
    files = report_files(args.target)
    if not files:
        sys.exit(f"no crashes/*.json for {args.target!r}: not a trace with MetricKit reports? "
                 f"(looked in {DEFAULT_TRACES}/<id>/files/crashes)")
    known = archive(args.dsyms)
    for path in files:
        render(path, args.all, known)


if __name__ == "__main__":
    main()
