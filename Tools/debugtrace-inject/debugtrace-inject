#!/usr/bin/env python3
"""
debugtrace-inject: the Mac side of live code patching. Standard library only.

    capture   after `build-and-sign --inject` built the app: record how every Swift
              module was compiled and keep a copy of the sources as they were built
    patch     turn the files edited since into a signed dylib per module
    commit    remember that those edits are now live in the running app
    reset     the app was relaunched: what runs is the build again

`debugtrace-mcp`'s `inject` tool is the front door; this does the work and prints JSON.

State lives in <project>/build/inject (build-and-sign passes it as --out):

    modules.json   per module: the compiler arguments, its sources, where it was built
    build/         the sources as the build compiled them
    live/          the sources as the running app has them (build/ plus what was injected)

A patch is diffed against live/, not build/: a function the agent changed and then
changed back differs from the injected version, so it is replaced again and the app
returns to the original behaviour. When the app is relaunched, live/ is reset to build/.
"""

import argparse
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import time

HERE = os.path.dirname(os.path.realpath(__file__))
REWRITER_DIR = os.path.join(HERE, "Rewriter")
REWRITER_SOURCES = [os.path.join(REWRITER_DIR, name) for name in ("main.swift", "BuildConfig.swift")]
STATE_HOME = os.path.expanduser(os.environ.get("XDG_STATE_HOME") or "~/.local/state")
REWRITER_BIN = os.path.join(STATE_HOME, "debugtrace", "bin", "debugtrace-rewrite")
BAS = os.environ.get("DEBUGTRACE_BAS") or os.path.expanduser("~/bin/build-and-sign")

# Arguments of the build's own compile command that a patch compile must not carry.
DROP_WITH_VALUE = {
    "-module-name", "-output-file-map", "-emit-localized-strings-path", "-emit-module-path",
    "-emit-objc-header-path", "-const-gather-protocols-list", "-dependency-scan-serialize-diagnostics-path",
    "-clang-build-session-file", "-working-directory", "-num-threads", "-clang-scanner-module-cache-path",
    "-sdk-module-cache-path", "-index-store-path", "-emit-module-interface-path", "-emit-const-values-path",
    "-serialize-diagnostics-path", "-emit-private-module-interface-path", "-emit-package-module-interface-path",
}
DROP_FLAGS = {
    "-c", "-emit-dependencies", "-emit-module", "-serialize-diagnostics", "-save-temps", "-no-color-diagnostics",
    "-explicit-module-build", "-validate-clang-modules-once", "-emit-objc-header", "-emit-const-values",
    "-whole-module-optimization", "-no-emit-module-separately-wmo", "-emit-localized-strings", "-profile-generate",
    "-profile-coverage-mapping", "-g", "-index-ignore-system-modules", "-incremental", "-enable-batch-mode",
    "-parse-as-library", "-emit-library", "-emit-executable",
}


class Failure(Exception):
    """A failure the caller reports as it is, with what to do about it."""

    def __init__(self, message, hint=None, **extra):
        super().__init__(message)
        self.message, self.hint, self.extra = message, hint, extra


def say(**fields):
    print(json.dumps(fields, indent=1, ensure_ascii=False))


# MARK: capture

def compile_commands(log):
    """[(module, args, cwd, files)] for every Swift module compiled in an xcodebuild log."""
    found = []
    for line in log.splitlines():
        if "builtin-SwiftDriver" not in line or "-module-name" not in line:
            continue
        try:
            words = shlex.split(line)
        except ValueError:
            continue
        compiler = next((i for i, w in enumerate(words) if w.endswith("/swiftc") or w == "swiftc"), None)
        if compiler is None:
            continue
        args = words[compiler + 1:]
        module = args[args.index("-module-name") + 1] if "-module-name" in args else None
        if not module:
            continue
        files, rest = [], []
        for arg in args:
            if arg.startswith("@") and arg.endswith(".SwiftFileList"):
                try:
                    with open(arg[1:]) as handle:
                        files += [p.strip().strip('"').replace("\\ ", " ") for p in handle if p.strip()]
                except OSError:
                    pass
            else:
                if arg.endswith(".swift") and os.path.isabs(arg):
                    files.append(arg)
                rest.append(arg)
        cwd = args[args.index("-working-directory") + 1] if "-working-directory" in args else None
        found.append((module, rest, cwd, files))
    return found


def snapshot(root, files, destination):
    for path in files:
        target = os.path.join(destination, path.lstrip("/"))
        os.makedirs(os.path.dirname(target), exist_ok=True)
        shutil.copyfile(path, target)


def command_capture(options):
    with open(options.log, errors="replace") as handle:
        commands = compile_commands(handle.read())
    out = options.out
    os.makedirs(out, exist_ok=True)
    state_path = os.path.join(out, "modules.json")
    try:
        with open(state_path) as handle:
            state = json.load(handle)
    except (OSError, ValueError):
        state = {"modules": {}}
    # An incremental build that found a module up to date prints no command for it:
    # keep what an earlier build recorded.
    for module, args, cwd, files in commands:
        state["modules"][module] = {"args": args, "cwd": cwd, "files": files}
    if not state["modules"]:
        raise Failure("no Swift compile commands in the build log",
                      "build with `build-and-sign --inject` once from a clean state: rm -rf build/DerivedData")
    if options.app_module in state["modules"]:
        state["appModule"] = options.app_module
    elif "appModule" not in state:
        state["appModule"] = (commands[-1][0] if commands else next(iter(state["modules"])))
    # Which modules this build made replaceable. An up-to-date module keeps
    # the arguments an earlier build recorded, which may be from a build with
    # another scope, so its arguments alone can't say.
    state["scope"] = options.scope
    state["products"] = options.products
    state["root"] = options.root
    for sub in ("build", "live"):
        shutil.rmtree(os.path.join(out, sub), ignore_errors=True)
    every = sorted({p for m in state["modules"].values() for p in m["files"]
                    if os.path.isfile(p) and "/DerivedSources/" not in p and "/DerivedData/" not in p})
    snapshot(options.root, every, os.path.join(out, "build"))
    snapshot(options.root, every, os.path.join(out, "live"))
    state["capturedAt"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    with open(state_path, "w") as handle:
        json.dump(state, handle, indent=1)
    print(f"recorded {len(state['modules'])} modules, {len(every)} sources "
          f"({len(commands)} compiled in this build) for live patching")


# MARK: patch

def load_state(directory):
    try:
        with open(os.path.join(directory, "modules.json")) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        raise Failure("this build was not made for live patching",
                      "rebuild and relaunch with `build-and-sign --mcp --inject`")


def rewriter():
    """The SwiftSyntax tool, built on first use from the toolchain's own SwiftSyntax."""
    stale = (not os.path.exists(REWRITER_BIN)
             or os.path.getmtime(REWRITER_BIN) < max(os.path.getmtime(f) for f in REWRITER_SOURCES))
    if not stale:
        return REWRITER_BIN
    swiftc = subprocess.run(["xcrun", "--find", "swiftc"], capture_output=True, text=True).stdout.strip()
    host = os.path.join(os.path.dirname(os.path.dirname(swiftc)), "lib", "swift", "host")
    os.makedirs(os.path.dirname(REWRITER_BIN), exist_ok=True)
    libraries = ["-lSwiftSyntax", "-lSwiftParser", "-lSwiftIfConfig", "-lSwiftDiagnostics", "-lSwiftOperators"]
    build = subprocess.run(
        ["xcrun", "swiftc", "-O", *REWRITER_SOURCES, "-module-name", "debugtrace_rewrite", "-I", host, "-L", host,
         *libraries, "-Xlinker", "-rpath", "-Xlinker", host, "-o", REWRITER_BIN], capture_output=True, text=True)
    if build.returncode != 0:
        raise Failure("could not build the patch rewriter", "this needs Xcode's toolchain: " + build.stderr[-600:])
    return REWRITER_BIN


OS_NAMES = {"xros": "visionOS", "ios": "iOS", "macos": "macOS", "macosx": "macOS", "tvos": "tvOS",
            "watchos": "watchOS"}


def compiler_version():
    """The toolchain's Swift version, e.g. [6, 3]: what `#if compiler(>=…)` compares against."""
    text = subprocess.run(["xcrun", "swiftc", "--version"], capture_output=True, text=True).stdout
    match = re.search(r"Swift version (\d+(?:\.\d+)*)", text)
    return [int(n) for n in match.group(1).split(".")] if match else [6]


_SDK_MODULES = {}


def sdk_clang_modules(sdk):
    """Top-level clang module names the SDK's module maps declare (Darwin, os, zlib…),
    which `canImport` finds without a framework or .swiftmodule of their own."""
    if sdk in _SDK_MODULES:
        return _SDK_MODULES[sdk]
    names = set()
    include = os.path.join(sdk, "usr", "include")
    maps = [os.path.join(include, f) for f in (os.listdir(include) if os.path.isdir(include) else [])
            if f.endswith(".modulemap")]
    maps += [os.path.join(include, d, "module.modulemap") for d in
             (os.listdir(include) if os.path.isdir(include) else [])]
    for path in maps:
        try:
            with open(path, errors="replace") as handle:
                names.update(re.findall(r"^\s*(?:explicit\s+)?(?:framework\s+)?module\s+([A-Za-z_]\w*)",
                                        handle.read(), re.M))
        except OSError:
            continue
    _SDK_MODULES[sdk] = sorted(names)
    return _SDK_MODULES[sdk]


def build_configuration(module_record, compiler):
    """What `#if` sees in this module: the target, conditions, language mode and
    search paths, from the arguments it was compiled with."""
    args = module_record["args"]
    config = {"os": "", "arch": "arm64", "environment": "", "conditions": [], "features": [],
              "languageVersion": [], "compilerVersion": compiler, "importPaths": [], "frameworkPaths": [],
              "sdk": ""}
    i = 0
    while i < len(args):
        arg = args[i]
        value = args[i + 1] if i + 1 < len(args) else ""
        if arg == "-target":
            # arm64-apple-xros26.0[-simulator]
            parts = value.split("-")
            config["arch"] = parts[0]
            if len(parts) >= 3:
                config["os"] = OS_NAMES.get(re.sub(r"[\d.]+$", "", parts[2]), parts[2])
            if len(parts) >= 4:
                config["environment"] = {"macabi": "macCatalyst"}.get(parts[3], parts[3])
            i += 2
        elif arg == "-D":
            config["conditions"].append(value)
            i += 2
        elif arg.startswith("-D") and len(arg) > 2:
            config["conditions"].append(arg[2:])
            i += 1
        elif arg in ("-enable-upcoming-feature", "-enable-experimental-feature"):
            config["features"].append(value.split(":")[0])
            i += 2
        elif arg == "-swift-version":
            config["languageVersion"] = [int(n) for n in value.split(".") if n.isdigit()]
            i += 2
        elif arg == "-sdk":
            config["sdk"] = value
            i += 2
        elif arg == "-I":
            config["importPaths"].append(value)
            i += 2
        elif arg.startswith("-I") and len(arg) > 2:
            config["importPaths"].append(arg[2:])
            i += 1
        elif arg in ("-F", "-Fsystem"):
            config["frameworkPaths"].append(value)
            i += 2
        elif arg.startswith("-F") and len(arg) > 2 and not arg.startswith("-Fsystem"):
            config["frameworkPaths"].append(arg[2:])
            i += 1
        else:
            i += 1
    config["sdkModules"] = sdk_clang_modules(config["sdk"]) if config["sdk"] else []
    # Swift 5 mode on a Swift 6 compiler answers swift(>=5.10), not swift(>=6).
    if config["languageVersion"][:1] == [5]:
        config["languageVersion"] = [5, 10]
    elif not config["languageVersion"]:
        config["languageVersion"] = compiler
    return config


def read(path):
    with open(path, "rb") as handle:
        return handle.read()


def patch_compile_arguments(module_record, name):
    """The module's own compile arguments, minus what builds its products."""
    args, out, i = module_record["args"], [], 0
    while i < len(args):
        arg = args[i]
        if arg in DROP_WITH_VALUE:
            i += 2
        elif arg in DROP_FLAGS or arg.startswith("@"):
            i += 1
        elif arg == "-module-cache-path":
            if i + 1 < len(args) and args[i + 1].endswith("ModuleCache.noindex"):
                out += [arg, args[i + 1]]
            i += 2
        elif arg == "-Xfrontend" and i + 1 < len(args) and args[i + 1] == "-serialize-debugging-options":
            i += 2
        elif arg == "-Xcc" and i + 1 < len(args) and args[i + 1] == "-ivfsstatcache":
            i += 4
        elif arg.endswith(".swift") and os.path.isabs(arg):
            i += 1
        else:
            out.append(arg)
            i += 1
    return out


def compile_patch(state, module, sources, label, work):
    record = state["modules"][module]
    dylib = os.path.join(work, f"{label}.dylib")
    command = (["xcrun", "swiftc"] + patch_compile_arguments(record, module)
               + ["-I", state["products"], "-module-name", f"DebugTracePatch_{label}", "-parse-as-library",
                  "-emit-library", "-o", dylib]
               + sources + ["-Xlinker", "-undefined", "-Xlinker", "dynamic_lookup"])
    started = time.monotonic()
    result = subprocess.run(command, capture_output=True, text=True, cwd=record.get("cwd") or None)
    if result.returncode != 0:
        errors = [l for l in result.stderr.splitlines() if "error:" in l or l.lstrip().startswith(("|", "`"))][:40]
        hint = "fix the error in the source file, then inject again"
        if "was not compiled for private import" in result.stderr:
            # Not the edit's fault: the module the patch compiles against was rebuilt without the patching flags,
            # typically by a plain xcodebuild (or a build-and-sign without --inject) into the same DerivedData.
            hint = (f"the {module} module in the build products was not built for live patching, so no patch can compile against it "
                    "(a plain `xcodebuild` or a `build-and-sign` without --inject into build/DerivedData overwrites it): "
                    "relaunch with `build-and-sign --mcp --inject`, and don't build into that DerivedData path afterwards")
        raise Failure(f"the patch for {module} did not compile", hint,
                      compileErrors=errors or result.stderr.splitlines()[-20:], patchSource=sources)
    return dylib, round((time.monotonic() - started) * 1000)


def run_source(module, snippet):
    # `import` is only legal at file scope, and a model starts a snippet with one
    # as often as not: hoist the leading import lines out of the function body.
    lines = snippet.splitlines()
    hoisted = []
    while lines and (not lines[0].strip() or re.match(r"\s*(@testable\s+)?import\s+\w", lines[0])):
        if lines[0].strip():
            hoisted.append(lines[0].strip())
        lines.pop(0)
    snippet = "\n".join(lines)
    return (
        "import Foundation\n"
        + "".join(f"{line}\n" for line in hoisted)
        + f"@testable import {module}\n\n"
        '@_cdecl("debugtrace_patch_entry")\n'
        "nonisolated public func debugtrace_patch_entry() -> UnsafeMutablePointer<CChar>? {\n"
        # The String crosses the isolation boundary, not the pointer: Swift 6
        # refuses a non-Sendable result from assumeIsolated.
        "    let text = MainActor.assumeIsolated { \"\\(__debugtraceRun())\" }\n"
        "    return strdup(text)\n"
        "}\n\n"
        "@MainActor func __debugtraceRun() -> Any {\n"
        f"{snippet}\n"
        "}\n"
    )


def sign(files, root):
    result = subprocess.run([BAS, "--sign-dylib"] + files, capture_output=True, text=True, cwd=root)
    if result.returncode != 0:
        tail = [l for l in (result.stdout + result.stderr).splitlines() if l.strip()][-6:]
        raise Failure("signing the patch failed", "check that build-and-sign can sign (certificate and profile in "
                      "~/.config/build-signing/global.conf)", detail=tail)


def replaceable(module_record, name=None, state=None):
    if state is not None and state.get("scope") == "app" and name != state.get("appModule"):
        return False
    return any(a == "-enable-implicit-dynamic" for a in module_record["args"])


def refusal_hint(problems, named):
    """What to tell an agent whose edit a patch can't carry. A bare "rebuild" made agents give up on live
    patching for any edit that touched a type, when most of those have a patchable shape."""
    hint = ("each entry in `because` says what to do instead. A patch replaces function and computed-property bodies and "
            "adds methods, nested and top-level types, `static let`s and typed `let` constants; it cannot change a type's "
            "header (inheritance, generics), add an instance stored property or change an initializer. To change what a "
            "type is, leave it as it was, write the new one as a new type and patch the code that uses it. "
            "Rebuild with `build-and-sign --mcp --inject` only if that is not possible")
    files = sorted({p["file"] for p in problems})
    if not named and len(files) > 1:
        hint += (f". Not every refusal need be yours: this call diffed every changed source file ({', '.join(files)}), and a file "
                 "someone else changed (another agent, a pull or a commit in a shared package) blocks the rest. Pass `files` with "
                 "just the ones you edited to patch those alone")
    elif not named:
        hint += (f". This call diffed every changed source file; if {files[0]} is not one you edited, someone else changed it, "
                 "and `files` with just yours patches without it")
    return hint


def command_patch(options):
    state = load_state(options.dir)
    root = state["root"]
    live, built = os.path.join(options.dir, "live"), os.path.join(options.dir, "build")
    where = {p: m for m, r in state["modules"].items() for p in r["files"]}

    if options.file:
        changed = []
        for name in options.file:
            path = name if os.path.isabs(name) else os.path.join(root, name)
            path = os.path.realpath(path) if os.path.exists(path) else path
            if path not in where:
                raise Failure(f"{name} is not a source file of this build",
                              "pass a Swift file that was compiled into the app; new files need a rebuild")
            changed.append(path)
    else:
        changed = [p for p in where if os.path.isfile(p) and os.path.isfile(os.path.join(live, p.lstrip("/")))
                   and read(p) != read(os.path.join(live, p.lstrip("/")))]
    changed = [p for p in changed if os.path.isfile(p) and read(p) != read(os.path.join(live, p.lstrip("/")))]
    if not changed and not options.run:
        say(ok=True, changed=[], note="no file differs from what the running app has; nothing to inject")
        return

    # Only modules built with implicit dynamic replacement can be patched:
    # INJECT_SCOPE=app builds the app's own module that way and leaves its
    # packages fully optimized.
    fixed = sorted({where[p] for p in changed if not replaceable(state["modules"][where[p]], where[p], state)})
    if fixed:
        raise Failure(
            f"{', '.join(fixed)} was built without live patching, so its code cannot be replaced",
            "this build patches only the app's own module (INJECT_SCOPE=app); to patch package code, rebuild "
            "with INJECT_SCOPE=all build-and-sign --mcp --inject, or move the change into the app",
            rebuildNeeded=True, modules=fixed)

    work = tempfile.mkdtemp(prefix="debugtrace-inject-")
    tool = rewriter()
    reports, per_module, problems = {}, {}, []
    compiler = None
    started = time.monotonic()
    for index, path in enumerate(changed):
        module = where[path]
        patch_file = os.path.join(work, f"{module}-{index}-{os.path.basename(path)}")
        config_file = os.path.join(work, f"{module}.build.json")
        if not os.path.exists(config_file):
            compiler = compiler or compiler_version()
            with open(config_file, "w") as handle:
                json.dump(build_configuration(state["modules"][module], compiler), handle)
        run = subprocess.run([tool, "--old", os.path.join(live, path.lstrip("/")), "--new", path, "--module", module,
                              "--source-file", os.path.basename(path), "--out", patch_file,
                              "--config", config_file]
                             + (["--built", os.path.join(built, path.lstrip("/"))]
                                if os.path.isfile(os.path.join(built, path.lstrip("/"))) else []),
                             capture_output=True, text=True)
        if run.returncode != 0:
            raise Failure(f"{os.path.basename(path)} does not parse", "fix the syntax error and inject again",
                          detail=run.stderr[-400:])
        report = json.loads(run.stdout)
        reports[os.path.relpath(path, root) if path.startswith(root) else path] = report
        problems += [{"file": os.path.basename(path), **p} for p in report["unpatchable"]]
        if report["hasPatch"]:
            per_module.setdefault(module, []).append(patch_file)
    if problems:
        raise Failure("this change cannot be applied to the running app", refusal_hint(problems, bool(options.file)),
                      rebuildNeeded=True, because=problems, files=reports)

    dylibs, timings = [], {"rewriteMs": round((time.monotonic() - started) * 1000), "compileMs": 0}
    for number, (module, sources) in enumerate(sorted(per_module.items())):
        dylib, ms = compile_patch(state, module, sources, f"{module}{number}", work)
        timings["compileMs"] += ms
        dylibs.append({"module": module, "path": dylib, "label": f"{module}: " + ", ".join(
            sorted({os.path.basename(s).split('-', 2)[2] for s in sources}))})
    if options.run:
        app = state.get("appModule")
        source = os.path.join(work, "DebugTraceRun.swift")
        with open(source, "w") as handle:
            handle.write(run_source(app, options.run))
        dylib, ms = compile_patch(state, app, [source], "Run", work)
        timings["compileMs"] += ms
        dylibs.append({"module": app, "path": dylib, "label": "run snippet"})
    started = time.monotonic()
    sign([d["path"] for d in dylibs], root)
    timings["signMs"] = round((time.monotonic() - started) * 1000)
    say(ok=True, dylibs=dylibs, changed=[p for p in changed], files=reports, timings=timings,
        commit=[p for p in changed])


# MARK: runtime

RUNTIME_SOURCE = os.path.join(HERE, "..", "..", "Sources", "DebugTraceInject", "DebugTraceInject.swift")


def command_runtime(options):
    """Compile DebugTraceInject itself, with the app's own compiler arguments, so a
    build made for patching can carry the runtime without the app linking it."""
    state = load_state(options.dir)
    work = tempfile.mkdtemp(prefix="debugtrace-runtime-")
    dylib, ms = compile_patch(state, state["appModule"], [os.path.realpath(RUNTIME_SOURCE)], "Runtime", work)
    os.makedirs(os.path.dirname(os.path.abspath(options.out)), exist_ok=True)
    shutil.copyfile(dylib, options.out)
    say(ok=True, path=options.out, compileMs=ms, module=state["appModule"])


# MARK: commit / reset

def command_commit(options):
    live = os.path.join(options.dir, "live")
    for path in options.file:
        if os.path.isfile(path):
            target = os.path.join(live, path.lstrip("/"))
            os.makedirs(os.path.dirname(target), exist_ok=True)
            shutil.copyfile(path, target)
    say(ok=True, note=f"{len(options.file)} file(s) are now the running app's source")


def command_reset(options):
    live, built = os.path.join(options.dir, "live"), os.path.join(options.dir, "build")
    shutil.rmtree(live, ignore_errors=True)
    shutil.copytree(built, live)
    say(ok=True, note="live sources reset to the build")


def main():
    parser = argparse.ArgumentParser(prog="debugtrace-inject", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)
    capture = sub.add_parser("capture")
    capture.add_argument("--log", required=True)
    capture.add_argument("--out", required=True)
    capture.add_argument("--root", required=True)
    capture.add_argument("--app-module", default="")
    capture.add_argument("--products", required=True)
    capture.add_argument("--scope", choices=["all", "app"], default="all")
    patch = sub.add_parser("patch")
    patch.add_argument("--dir", required=True)
    patch.add_argument("--file", action="append")
    patch.add_argument("--run")
    commit = sub.add_parser("commit")
    commit.add_argument("--dir", required=True)
    commit.add_argument("--file", action="append", required=True)
    runtime = sub.add_parser("runtime")
    runtime.add_argument("--dir", required=True)
    runtime.add_argument("--out", required=True)
    reset = sub.add_parser("reset")
    reset.add_argument("--dir", required=True)
    options = parser.parse_args()
