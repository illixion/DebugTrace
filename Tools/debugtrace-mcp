CLIENT_NAME = os.environ.get("DEBUGTRACE_CLIENT_NAME") or f"An agent on {os.uname().nodename.split('.')[0]}"
BROWSE_SECONDS = float(os.environ.get("DEBUGTRACE_BROWSE_SECONDS", "1.5"))
