class ToolError(Exception):
    """A failure the model should see, with what to do about it."""

    def __init__(self, message, hint=None):
        super().__init__(message)
        self.message = message
        self.hint = hint

    def text(self):
        return self.message + (f"\nhint: {self.hint}" if self.hint else "")


# MARK: sessions

def pid_is_console_streamer(pid):
    try:
        os.kill(pid, 0)
    except (OSError, TypeError):
        return False
    try:
        command = subprocess.run(["ps", "-p", str(pid), "-o", "command="], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return False
    return "devicectl" in command


# MARK: Bonjour

_ZONE_LINE = re.compile(r"^(\S+)\s+(SRV|TXT)\s+(.*)$")
_TXT_STRING = re.compile(r'"((?:[^"\\]|\\.)*)"')


def _unescape(text):
    """dns-sd's zone escapes: \\DDD (decimal byte) and \\X (literal X)."""
    out = bytearray()
    i = 0
    raw = text.encode()
    while i < len(raw):
        if raw[i] == 0x5C and i + 3 < len(raw) and raw[i + 1:i + 4].isdigit():
            out.append(int(raw[i + 1:i + 4]))
            i += 4
        elif raw[i] == 0x5C and i + 1 < len(raw):
            out.append(raw[i + 1])
            i += 2
        else:
            out.append(raw[i])
            i += 1
    return out.decode("utf-8", "replace")


def parse_zone(text):
    """`dns-sd -Z` output -> [{instance, host, port, txt}] for complete services."""
    services = {}
    suffix = "." + SERVICE_TYPE
    for line in text.splitlines():
        match = _ZONE_LINE.match(line.strip())
        if not match or not match.group(1).endswith(suffix):
            continue
        name = _unescape(match.group(1)[:-len(suffix)])
        entry = services.setdefault(name, {"instance": name})
        if match.group(2) == "SRV":
            fields = match.group(3).split()
            if len(fields) >= 4 and fields[2].isdigit():
                entry["port"] = int(fields[2])
                entry["host"] = fields[3].rstrip(".")
        else:
            txt = {}
            for item in _TXT_STRING.findall(match.group(3)):
                key, _, value = _unescape(item).partition("=")
                txt[key] = value
            entry["txt"] = txt
    return [s for s in services.values() if "port" in s and "txt" in s]


def browse(seconds=None):
    """One short `dns-sd -Z` run; [] when dns-sd is missing or finds nothing."""
    try:
        process = subprocess.Popen(["dns-sd", "-Z", SERVICE_TYPE, "local"], stdout=subprocess.PIPE,
                                   stderr=subprocess.DEVNULL, text=True)
    except OSError:
        return []
    time.sleep(BROWSE_SECONDS if seconds is None else seconds)
    process.terminate()
    try:
        output, _ = process.communicate(timeout=2)
    except subprocess.TimeoutExpired:
        process.kill()
        output, _ = process.communicate()
    return parse_zone(output or "")


def ledger_record(key_id):
    if not key_id or not re.fullmatch(r"[A-Za-z0-9._-]{1,64}", key_id):
        return None
    try:
        with open(os.path.join(KEY_DIR, f"{key_id}.json")) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return None


def advertisement_tag(token, nonce):
    """The `t` a server with this token advertises for nonce `n`
    (DebugTraceServer.advertisementTag)."""
    digest = hmac.new(token.encode(), f"debugtrace-advert|{nonce}".encode(), hashlib.sha256).digest()
    return base64.urlsafe_b64encode(digest[:12]).decode().rstrip("=")


def ledger_records():
    """Every ledger record that holds a command token."""
    records = []
    try:
        names = os.listdir(KEY_DIR)
    except OSError:
        return records
    for name in names:
        if name.endswith(".json"):
            record = ledger_record(name[:-5])
            if record and record.get("commandToken"):
                records.append(record)
    return records


def recognise(txt, records):
    """The ledger record behind an advertisement, or None. Current builds are
    matched by their tag; builds from before it still name their keyId."""
    nonce, tag = txt.get("n"), txt.get("t")
    if nonce and tag:
        for record in records:
            if hmac.compare_digest(advertisement_tag(record["commandToken"], nonce), tag):
                return record
        return None
    return ledger_record(txt.get("keyId"))


def discovered_sessions(services=None):
    """Advertised servers as session dicts. `attachable` is false, with a
    reason, when this Mac's ledger has no token for that build."""
    sessions = []
    services = browse() if services is None else services
    records = ledger_records() if services else []
    for service in services:
        txt = service["txt"]
        record = recognise(txt, records) or {}
        project = os.path.basename(record.get("project") or "")
        session = {
            "appName": txt.get("name") or project or record.get("bundleId") or "An unrecognised app",
            "bundleId": record.get("bundleId") or txt.get("bundleId"),
            "build": record.get("build") or txt.get("build"), "version": txt.get("version"),
            "keyId": record.get("keyId") or txt.get("keyId"),
            "device": record.get("device") or service["host"].removesuffix(".local"),
            "url": f"http://{service['host']}:{service['port']}", "startedAt": None, "source": "bonjour",
        }
        if record.get("commandToken"):
            session["token"] = record["commandToken"]
            session["attachable"] = True
        else:
            session["attachable"] = False
            session["reason"] = ("built on another Mac, or before per-build tokens: not in this Mac's key ledger"
                                 if not record else "this build has no command token; rebuild it with build-and-sign")
        sessions.append(session)
    return sessions


_discovery = {"at": 0.0, "sessions": []}


def recent_discoveries(max_age=5.0):
    if time.monotonic() - _discovery["at"] > max_age:
        _discovery["sessions"] = discovered_sessions()
        _discovery["at"] = time.monotonic()
    return _discovery["sessions"]


def session_records():
    sessions = []
    try:
        names = sorted(os.listdir(SESSIONS_DIR))
    except FileNotFoundError:
        return sessions
    for name in names:
        if not name.endswith(".json"):
            continue
        path = os.path.join(SESSIONS_DIR, name)
        try:
            with open(path) as handle:
                session = json.load(handle)
        except (OSError, ValueError):
            continue
        if pid_is_console_streamer(session.get("pid")):
            session["_path"] = path
            sessions.append(session)
        else:
            # The app ended (its console stream exited): the session is over.
            try:
                os.remove(path)
            except OSError:
                pass
    return sessions


def _port(url):
    return url.rsplit(":", 1)[-1].rstrip("/")


def all_sessions():
    """Session records (bas --mcp: console attached) plus attachable Bonjour
    finds. A record wins over its own advertisement, matched on bundle id and port."""
    sessions = session_records()
    seen = {(s.get("bundleId"), _port(s.get("url", ""))) for s in sessions}
    for found in recent_discoveries():
        if (found.get("bundleId"), _port(found["url"])) not in seen:
            sessions.append(found)
    return sessions


def live_sessions():
    return [s for s in all_sessions() if s.get("attachable", True)]


def describe(session):
    # Never the token.
    keys = ("appName", "bundleId", "build", "device", "url", "startedAt", "consoleLog", "source", "attachable", "reason")
    described = {key: session[key] for key in keys if session.get(key) is not None}
    # From the session record alone: listing apps sends no request to any of them.
    if session.get("injectDir"):
        described["inject"] = {"ready": True, "note": "launched with --inject: edit Swift files, then call `inject`"}
    elif session.get("source") == "bonjour":
        described["inject"] = {"ready": "unknown", "note": "attached without a launch record; `inject` finds out when called, "
                                                           "or relaunch with `build-and-sign --mcp --inject`"}
    else:
        described["inject"] = {"ready": False, "note": "not launched with --inject; `inject` needs "
                                                       "`build-and-sign --mcp --inject` from the app's repo"}
    return described


def resolve(app):
    sessions = live_sessions()
    if not sessions:
        raise ToolError("no app is running with its debug server",
                        "open a dev build signed by build-and-sign on a device on this network, or launch one "
                        "with `build-and-sign --mcp` (from the app's repo), then call `apps`")
    if not app:
        if len(sessions) == 1:
            return sessions[0]
        names = ", ".join(s.get("appName") or s.get("bundleId") for s in sessions)
        raise ToolError(f"{len(sessions)} apps are running ({names})", "pass `app` with one of those names")
    wanted = app.strip().lower()
    # "Hypnos@ixPhone": the same app can run on several devices at once.
    device = None
    if "@" in wanted:
        wanted, device = (part.strip() for part in wanted.rsplit("@", 1))
        on_device = [s for s in sessions if (s.get("device") or "").lower() == device]
        if not on_device:
            devices = sorted({s.get("device") for s in sessions if s.get("device")})
            raise ToolError(f"no running app is on a device named '{device}'",
                            f"devices with apps running: {', '.join(devices) or 'none'}")
        sessions = on_device

    def keys(session):
        bundle = (session.get("bundleId") or "").lower()
        return {bundle, (session.get("appName") or "").lower(), bundle.rsplit(".", 1)[-1]}

    exact = [s for s in sessions if wanted in keys(s)]
    matches = exact or [s for s in sessions if any(wanted in key for key in keys(s) if key)]
    if len(matches) == 1:
        return matches[0]
    names = ", ".join(s.get("appName") or s.get("bundleId") for s in (matches or sessions))
    if matches:
        devices = sorted({m.get("device") for m in matches if m.get("device")})
        bundles = {m.get("bundleId") for m in matches}
        if len(bundles) == 1 and len(devices) > 1:
            bundle = matches[0].get("bundleId")
            raise ToolError(f"'{app}' is running on several devices ({', '.join(devices)})",
                            "add the device: " + " or ".join(f"{bundle}@{d}" for d in devices))
        raise ToolError(f"'{app}' matches several running apps ({names})", "pass the full bundle id")
    raise ToolError(f"no running app matches '{app}'", f"running now: {names}; call `apps` for details")


# MARK: HTTP

def token():
    try:
        with open(TOKEN_FILE) as handle:
            value = handle.read().strip()
            return value or None
    except OSError:
        return None


def request(session, path, body=None):
    url = session["url"].rstrip("/") + path
    # Shown in the app's "Allow debug access?" prompt.
    headers = {"Accept": "application/json", "X-DebugTrace-Client": CLIENT_NAME}
    value = session.get("token") or token()
    if value:
        headers["Authorization"] = f"Bearer {value}"
    data = None
    if body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=data, headers=headers, method="POST" if body is not None else "GET")
    try:
        with urllib.request.urlopen(req, timeout=CALL_TIMEOUT_SECONDS) as response:
            return response.status, response.headers.get("Content-Type", ""), response.read()
    except urllib.error.HTTPError as error:
        return error.code, error.headers.get("Content-Type", ""), error.read()
    except (urllib.error.URLError, OSError) as error:
        raise ToolError(f"{session.get('appName')} did not answer at {session['url']}: {getattr(error, 'reason', error)}",
                        "the app may be suspended or the device asleep; bring it to the foreground, or relaunch with `build-and-sign --mcp`")


_verified = set()


def verified(session):
    """The session file says which app is on this port; make sure it still is."""
    key = (session["url"], session.get("startedAt"))
    if key in _verified:
        return session
    status, _, raw = request(session, "/_info")
    try:
        info = json.loads(raw)
    except ValueError:
        info = {}
    bundle = ((info.get("data") or {}).get("app") or {}).get("bundleId")
    if status == 401:
        raise ToolError(f"{session.get('appName')} refused the token",
                        "the build on the device is not the one the ledger describes; reinstall it with build-and-sign")
    if bundle and bundle != session.get("bundleId"):
        raise ToolError(f"{session['url']} is now served by {bundle}, not {session.get('bundleId')}",
                        "relaunch the app with `build-and-sign --mcp` to refresh its session")
    _verified.add(key)
    return session


# MARK: tools

def text_result(value, is_error=False):
    text = value if isinstance(value, str) else json.dumps(value, indent=2, ensure_ascii=False)
    result = {"content": [{"type": "text", "text": text}]}
    if is_error:
        result["isError"] = True
    return result


def save_file(session, relative, data):
    root = session.get("projectRoot") or os.path.expanduser("~/Downloads")
    path = os.path.join(root, "build", "debugtrace", relative)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "wb") as handle:
        handle.write(data)
    return path


def tool_apps(_):
    sessions = all_sessions()
    if not sessions:
        return text_result({"apps": [], "hint": "open a dev build signed by build-and-sign on a device on this network, "
                                                "or launch one with `build-and-sign --mcp`"})
    return text_result({"apps": [describe(s) for s in sessions]})


def tool_help(arguments):
    session = verified(resolve(arguments.get("app")))
    endpoint = arguments.get("endpoint")
    path = "/" + (f"?endpoint={urllib.request.quote(endpoint)}" if endpoint else "")
    status, _, raw = request(session, path)
    return text_result(raw.decode("utf-8", "replace"), is_error=status >= 400)


def tool_call(arguments):
    session = verified(resolve(arguments.get("app")))
    endpoint = arguments.get("endpoint")
    if not endpoint:
        raise ToolError("`endpoint` is required", "call `help` to list the app's endpoints")
    if not isinstance(endpoint, str):
        raise ToolError("`endpoint` must be a string", "call `help` to list the app's endpoints")
    status, content_type, raw = request(session, "/_call", {"name": endpoint, "arguments": arguments.get("arguments") or {}})
    if content_type.startswith("application/json"):
        return text_result(raw.decode("utf-8", "replace"), is_error=status >= 400)
    if content_type.startswith("image/"):
        return {"content": [{"type": "image", "data": base64.b64encode(raw).decode(), "mimeType": content_type.split(";")[0]}]}
    extension = content_type.split("/")[-1].split(";")[0] or "bin"
    path = save_file(session, f"{endpoint}.{extension}", raw)
    return text_result({"ok": True, "endpoint": endpoint, "savedTo": path, "contentType": content_type, "bytes": len(raw)})


def tool_trace(arguments):
    session = verified(resolve(arguments.get("app")))
    call_arguments = {k: arguments[k] for k in ("note", "logMinutes") if k in arguments}
    status, _, raw = request(session, "/_call", {"name": "_trace", "arguments": call_arguments})
    try:
        reply = json.loads(raw)
    except ValueError:
        return text_result(raw.decode("utf-8", "replace"), is_error=True)
    if status >= 400 or not reply.get("ok"):
        return text_result(reply, is_error=True)
    data = reply["data"]
    status, _, archive = request(session, data["download"])
    if status >= 400:
        return text_result(archive.decode("utf-8", "replace"), is_error=True)
    path = save_file(session, os.path.join("traces", data["filename"]), archive)
    return text_result({"savedTo": path, "traceId": data["traceId"], "signed": data["signed"], "bytes": len(archive),
                        "files": [f["path"] for f in data.get("files", [])]})


INJECT_TOOL = os.path.join(os.path.dirname(os.path.realpath(__file__)), "debugtrace-inject", "debugtrace-inject")
# The server refuses bodies over 1 MiB (Configuration.maxBodyBytes); a patch travels base64-encoded.
MAX_PATCH_BASE64 = 900_000


def run_inject_tool(session, *command):
    """The helper's JSON reply and exit status. It prints JSON on success and on failure."""
    try:
        result = subprocess.run([INJECT_TOOL, *command], capture_output=True, text=True, cwd=session.get("projectRoot") or None,
                                timeout=CALL_TIMEOUT_SECONDS)
    except (OSError, subprocess.SubprocessError) as error:
        raise ToolError(f"could not run debugtrace-inject: {error}", f"expected at {INJECT_TOOL}")
    try:
        return json.loads(result.stdout), result.returncode
    except ValueError:
        raise ToolError("debugtrace-inject failed: " + (result.stderr or result.stdout)[-600:])


def app_call(session, name, arguments):
    status, _, raw = request(session, "/_call", {"name": name, "arguments": arguments})
    try:
        reply = json.loads(raw)
    except ValueError:
        raise ToolError(f"{session.get('appName')} answered {status} with something that is not JSON", raw.decode("utf-8", "replace")[:300])
    return status, reply


def tool_inject(arguments):
    session = verified(resolve(arguments.get("app")))
    directory = session.get("injectDir")
    if not directory:
        raise ToolError(f"{session.get('appName')} was not launched for live patching",
                        "rebuild and relaunch it with `build-and-sign --mcp --inject` from the app's repo")
    files = arguments.get("files") or []
    if isinstance(files, str):
        files = [files]
    if not isinstance(files, list) or not all(isinstance(f, str) for f in files):
        raise ToolError("`files` must be a list of paths", "e.g. {\"files\": [\"Game/Player.swift\"]}")

    # Is the app still the process that was built? A relaunch resets it to the build.
    status, listed = app_call(session, "_patches", {})
    if not listed.get("ok"):
        error = listed.get("error") or {}
        if error.get("code") == "not_found":
            raise ToolError(f"{session.get('appName')} has no `_inject` endpoint",
                            "link the DebugTraceInject product and call DebugTraceInject.register() at launch, then rebuild with --inject")
        return text_result(listed, is_error=True)
    if not (listed.get("data") or {}).get("patches"):
        run_inject_tool(session, "reset", "--dir", directory)

    command = ["patch", "--dir", directory]
    for name in files:
        command += ["--file", name]
    if arguments.get("run"):
        command += ["--run", arguments["run"]]
    plan, code = run_inject_tool(session, *command)
    if code != 0 or not plan.get("ok"):
        return text_result(plan, is_error=True)
    dylibs = plan.get("dylibs") or []
    if not dylibs:
        return text_result(plan)

    started = time.monotonic()
    loaded, output = [], None
    for dylib in dylibs:
        with open(dylib["path"], "rb") as handle:
            encoded = base64.b64encode(handle.read()).decode()
        if len(encoded) > MAX_PATCH_BASE64:
            raise ToolError(f"the patch for {dylib['module']} is {len(encoded) // 1024} KiB, over the server's body limit",
                            "inject fewer files at once")
        status, reply = app_call(session, "_inject", {"patch": encoded, "label": dylib["label"]})
        if status >= 400 or not reply.get("ok"):
            return text_result({"ok": False, "applied": loaded, "failedAt": dylib["label"], "reply": reply,
                                "hint": "files are unchanged on disk; fix the reported problem and call inject again"}, is_error=True)
        loaded.append(dylib["label"])
        data = reply.get("data") or {}
        if data.get("output") is not None:
            output = data["output"]
    if plan.get("commit"):
        run_inject_tool(session, "commit", "--dir", directory, *sum((["--file", f] for f in plan["commit"]), []))
    summary = {"ok": True, "applied": loaded}
    for relative, report in (plan.get("files") or {}).items():
        summary.setdefault("patched", []).extend(f"{relative}: {name}" for name in report.get("patched", []))
        if report.get("added"):
            summary.setdefault("added", []).extend(f"{relative}: {name}" for name in report["added"])
    if output is not None:
        summary["output"] = output
    timings = dict(plan.get("timings") or {})
    timings["loadMs"] = round((time.monotonic() - started) * 1000)
    summary["timings"] = timings
    return text_result(summary)


HANDLERS = {"apps": tool_apps, "help": tool_help, "call": tool_call, "inject": tool_inject, "trace": tool_trace}


# MARK: Argument normalisation
#
# The main client is a language model, and models guess parameter names:
# `args` or `params` for `arguments`, `name` for `endpoint`, or the endpoint's
# own arguments flattened next to `endpoint`. Silently ignoring a guess ran a
# command with its defaults, so each tool instead accepts the common
# variants, says in the reply which it accepted, and rejects any other name
# with the valid ones listed.

ALIASES = {
    "app": ("bundleId", "bundle_id", "bundle", "appName", "application"),
    "endpoint": ("name", "endpointName", "endpoint_name", "tool", "method"),
    "arguments": ("args", "params", "parameters", "input", "payload", "body"),
    "files": ("file", "paths", "path", "sources"),
    "run": ("code", "snippet", "eval", "script", "swift", "expression"),
}


def normalize_arguments(tool_name, raw):
    """(arguments, notes) with aliases resolved, or a ToolError saying what to use."""
    import difflib

    known = list(next(t for t in TOOLS if t["name"] == tool_name)["inputSchema"]["properties"])
    taken = {}
    notes = []
    extras = {}
    for key, value in raw.items():
        canonical = key if key in known else next(
            (name for name in known if key in ALIASES.get(name, ())), None)
        if canonical is None:
            extras[key] = value
            continue
        if canonical in taken:
            raise ToolError(f"`{canonical}` was given twice (as `{taken[canonical]}` and `{key}`)",
                            f"pass it once, as `{canonical}`")
        taken[canonical] = key
        if key != canonical:
            notes.append(f"`{key}` was accepted as `{canonical}`; use `{canonical}` next time")
    result = {taken_as: raw[source] for taken_as, source in taken.items()}

    if tool_name == "call":
        # `arguments` as a JSON string is a common slip; parse it.
        if isinstance(result.get("arguments"), str):
            try:
                result["arguments"] = json.loads(result["arguments"])
                notes.append("`arguments` was a JSON string; pass it as an object")
            except ValueError:
                raise ToolError("`arguments` is not valid JSON", "pass an object, e.g. {\"level\": \"error\"}")
        if "arguments" in result and not isinstance(result["arguments"], dict):
            raise ToolError("`arguments` must be an object keyed by the endpoint's parameter names",
                            "call `help` for the endpoint's parameters")
        # Arguments flattened next to `endpoint` are the endpoint's own.
        if extras:
            if "arguments" in result:
                raise ToolError(f"unexpected top-level {', '.join('`' + k + '`' for k in extras)} alongside `arguments`",
                                "put the endpoint's parameters inside `arguments`")
            result["arguments"] = extras
            notes.append(f"{', '.join('`' + k + '`' for k in extras)} were passed at the top level and "
                         "treated as the endpoint's arguments; nest them under `arguments` next time")
    elif extras:
        key = next(iter(extras))
        close = difflib.get_close_matches(key, known, n=1)
        raise ToolError(f"unknown parameter `{key}` for `{tool_name}`",
                        (f"did you mean `{close[0]}`? " if close else "") + f"valid parameters: {', '.join(known) or 'none'}")
    return result, notes


# MARK: JSON-RPC over stdio

def handle(message):
    method = message.get("method")
    request_id = message.get("id")
    if request_id is None:
        return None  # a notification
    if method == "initialize":
        asked = (message.get("params") or {}).get("protocolVersion")
        version = asked if asked in PROTOCOL_VERSIONS else PROTOCOL_VERSIONS[0]
        result = {"protocolVersion": version, "capabilities": {"tools": {}},
                  "serverInfo": {"name": "debugtrace-apps", "version": "1"}, "instructions": INSTRUCTIONS}
    elif method == "ping":
        result = {}
    elif method == "tools/list":
        result = {"tools": TOOLS}
    elif method == "tools/call":
        params = message.get("params") or {}
        handler = HANDLERS.get(params.get("name"))
        if handler is None:
            return {"jsonrpc": "2.0", "id": request_id,
                    "error": {"code": -32602, "message": f"unknown tool {params.get('name')!r}; tools: {', '.join(HANDLERS)}"}}
        try:
            raw = params.get("arguments") or {}
            if not isinstance(raw, dict):
                raise ToolError("tool arguments must be an object")
            arguments, notes = normalize_arguments(params["name"], raw)
            result = handler(arguments)
            if notes:
                result["content"].append({"type": "text", "text": "note: " + "; ".join(notes)})
        except ToolError as error:
            result = text_result(error.text(), is_error=True)
        except Exception as error:  # never take the agent's MCP connection down
            result = text_result(f"internal error: {error}", is_error=True)
    else:
        return {"jsonrpc": "2.0", "id": request_id, "error": {"code": -32601, "message": f"method not found: {method}"}}
    return {"jsonrpc": "2.0", "id": request_id, "result": result}


def main():
    if sys.argv[1:2] == ["discover"]:
        print(json.dumps([describe(s) | {"keyId": s.get("keyId")} for s in all_sessions()], indent=2))
        return
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            message = json.loads(line)
        except ValueError:
            response = {"jsonrpc": "2.0", "id": None, "error": {"code": -32700, "message": "parse error"}}
        else:
            response = handle(message) if isinstance(message, dict) else \
                {"jsonrpc": "2.0", "id": None, "error": {"code": -32600, "message": "batches are not supported"}}
        if response is not None:
            sys.stdout.write(json.dumps(response) + "\n")
            sys.stdout.flush()


if __name__ == "__main__":
    main()
